{
  "info": {
    "_postman_id": "gym-management-api-v1",
    "name": "Gym & Fitness Club Management API",
    "description": "Complete Postman test suite for Assignment 08 Gym & Fitness Club Management REST API including session auth, class capacity constraints, and membership renewals.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "classId",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Member (1 Month)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"fit_sam\",\n  \"email\": \"sam@fit.com\",\n  \"password\": \"mypassword123\",\n  \"membershipTier\": \"Gold\",\n  \"durationMonths\": 1,\n  \"emergencyContact\": \"+1-555-0199\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Register Member 2 (Platinum)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sarah_fit\",\n  \"email\": \"sarah@fit.com\",\n  \"password\": \"mypassword123\",\n  \"membershipTier\": \"Platinum\",\n  \"durationMonths\": 3,\n  \"emergencyContact\": \"+1-555-0188\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login Member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"fit_sam\",\n  \"password\": \"mypassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile (/api/auth/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Logout Member",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Fitness Classes",
      "item": [
        {
          "name": "Create Workout Class",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Zumba Cardio\",\n  \"trainerName\": \"Maria\",\n  \"scheduleDate\": \"2026-04-15T09:00:00.000Z\",\n  \"durationMinutes\": 60,\n  \"maxCapacity\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            }
          }
        },
        {
          "name": "Create Limited Capacity Class (maxCapacity = 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"HIIT Bootcamp\",\n  \"trainerName\": \"Coach Carter\",\n  \"scheduleDate\": \"2026-04-20T10:00:00.000Z\",\n  \"durationMinutes\": 45,\n  \"maxCapacity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            }
          }
        },
        {
          "name": "Fetch All Classes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            }
          }
        },
        {
          "name": "Filter Classes by Trainer (?trainer=Maria)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes?trainer=Maria",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"],
              "query": [
                {
                  "key": "trainer",
                  "value": "Maria"
                }
              ]
            }
          }
        },
        {
          "name": "Get Single Class Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}"]
            }
          }
        },
        {
          "name": "Book Class Seat",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}/book",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}", "book"]
            }
          }
        },
        {
          "name": "Cancel Class Booking",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Membership Management",
      "item": [
        {
          "name": "Renew Membership Expiry Date",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"additionalMonths\": 6,\n  \"tier\": \"Platinum\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/members/{{memberId}}/renew",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "{{memberId}}", "renew"]
            }
          }
        },
        {
          "name": "Get Expired Members List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/members/expired",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "expired"]
            }
          }
        }
      ]
    }
  ]
}
