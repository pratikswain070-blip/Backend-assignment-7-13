# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pharmacy_db?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=super_secret_pharmacy_jwt_key_change_in_production
JWT_EXPIRE=7d

# Secret Key required to register Admin and Pharmacist staff members
ADMIN_REGISTRATION_KEY=admin_secret_key_12345
